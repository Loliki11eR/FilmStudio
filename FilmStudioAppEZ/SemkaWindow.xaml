<Window x:Class="FilmStudioAppEZ.SemkaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Icon="Images/icon-semka.png"
        Title="Съёмочная группа" Height="450" Width="950" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- таблица состава съемочных групп -->
        <DataGrid x:Name="dgSostavGruppy" Grid.Row="0" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,10">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0EA5E9"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding Код_состава_группы}" Width="50"/>
                <DataGridTextColumn Header="съёмочная группа" Binding="{Binding Съемочная_группа1.Название_группы}" Width="200"/>
                <DataGridTextColumn Header="фамилия сотрудника" Binding="{Binding Сотрудник1.Фамилия}" Width="150"/>
                <DataGridTextColumn Header="имя сотрудника" Binding="{Binding Сотрудник1.Имя}" Width="150"/>
                <DataGridTextColumn Header="специализация" Binding="{Binding Сотрудник1.Специализация1.Наименование}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- панель кнопок -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnDobavit" Content="добавить" Background="#0EA5E9" Foreground="White" Width="110" Height="32" Margin="0,0,10,0" Click="btnDobavit_Click"/>
                <Button x:Name="btnRedaktirovat" Content="редактировать" Background="#0EA5E9" Foreground="White" Width="130" Height="32" Margin="0,0,10,0" Click="btnRedaktirovat_Click"/>
                <Button x:Name="btnUdalit" Content="удалить" Background="#EF4444" Foreground="White" Width="110" Height="32" Click="btnUdalit_Click"/>
            </StackPanel>

            <!-- кнопка перехода к созданию самих групп -->
            <Button x:Name="btnUpravlenieGruppami" Content="управление группами" Background="#0EA5E9" Foreground="White" Width="160" Height="32" HorizontalAlignment="Right" Click="btnUpravlenieGruppami_Click"/>
        </Grid>
    </Grid>
</Window>
