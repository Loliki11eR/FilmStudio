<Window x:Class="FilmStudioAppEZ.SotrudnikiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Icon="Images/icon-employees.png"
        Title="Сотрудники" Height="450" Width="1000">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- панель поиска -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="поиск по фамилии:" VerticalAlignment="Center" Margin="0,0,10,0" 
                       FontSize="14" Foreground="#1E293B"/>
            <TextBox x:Name="txtPoisk" Width="280" Height="28" TextChanged="txtPoisk_TextChanged" 
                     FontSize="13" Foreground="#1E293B" Background="White" BorderBrush="#CBD5E1"/>
        </StackPanel>

        <!-- таблица сотрудников -->
        <DataGrid x:Name="dgSotrudniki" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowBackground="White"
                  AlternatingRowBackground="#F8F9FA"
                  Margin="0,0,0,10">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0EA5E9"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- привязка идентификатора -->
                <DataGridTextColumn Header="id" Binding="{Binding Код_сотрудника}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- привязка фамилии -->
                <DataGridTextColumn Header="фамилия" Binding="{Binding Фамилия}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- привязка имени -->
                <DataGridTextColumn Header="имя" Binding="{Binding Имя}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- привязка специализации -->
                <DataGridTextColumn Header="специализация" Binding="{Binding Специализация1.Наименование}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- привязка телефона -->
                <DataGridTextColumn Header="телефон" Binding="{Binding Номер_телефона}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- привязка почты -->
                <DataGridTextColumn Header="email" Binding="{Binding Почта}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- привязка ставки -->
                <DataGridTextColumn Header="ставка" Binding="{Binding Ставка, StringFormat={}{0:F2}}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Padding" Value="5,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!-- панель кнопок -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="btnDobavit" Content="добавить" 
                    Background="#0EA5E9" Foreground="White"
                    Width="110" Height="32" Margin="0,0,10,0" Click="btnDobavit_Click"/>
            <Button x:Name="btnRedaktirovat" Content="редактировать" 
                    Background="#0EA5E9" Foreground="White"
                    Width="130" Height="32" Margin="0,0,10,0" Click="btnRedaktirovat_Click"/>
            <Button x:Name="btnUdalit" Content="удалить" 
                    Background="#EF4444" Foreground="White"
                    Width="110" Height="32" Click="btnUdalit_Click"/>
        </StackPanel>
    </Grid>
</Window>
