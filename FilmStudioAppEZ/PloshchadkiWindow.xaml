<Window x:Class="FilmStudioAppEZ.PloshchadkiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Icon="Images/icon-court.png"
        Title="Площадки" Height="450" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- таблица площадок -->
        <DataGrid x:Name="dgPloshadki" Grid.Row="0" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,10">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0EA5E9"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="id" Binding="{Binding Код_площадки}" Width="50"/>
                <DataGridTextColumn Header="адрес" Binding="{Binding Адрес}" Width="250"/>
                <DataGridTextColumn Header="тип площадки" Binding="{Binding Тип_площадки.Наименование}" Width="150"/>
                <DataGridTextColumn Header="стоимость аренды (день)" Binding="{Binding Стоимость_аренды_в_день, StringFormat={}{0:N2}}" Width="180"/>
                <DataGridTextColumn Header="вместимость (чел)" Binding="{Binding Вместимость}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- панель кнопок -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="btnDobavit" Content="добавить" Background="#0EA5E9" Foreground="White" Width="110" Height="32" Margin="0,0,10,0" Click="btnDobavit_Click"/>
            <Button x:Name="btnRedaktirovat" Content="редактировать" Background="#0EA5E9" Foreground="White" Width="130" Height="32" Margin="0,0,10,0" Click="btnRedaktirovat_Click"/>
            <Button x:Name="btnUdalit" Content="удалить" Background="#EF4444" Foreground="White" Width="110" Height="32" Click="btnUdalit_Click"/>
        </StackPanel>
    </Grid>
</Window>
