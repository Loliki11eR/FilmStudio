<Window x:Class="FilmStudioAppEZ.AutorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Background="#F8F9FA"
        Icon="Images/icon-autorization.png"
        WindowStartupLocation="CenterScreen"
        Title="Авторизация в систему" Height="380" Width="360" ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <StackPanel VerticalAlignment="Center" Margin="30">
            <TextBlock Text="ВХОД В СИСТЕМУ" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#1E293B"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5" Foreground="#1E293B"/>
            <TextBox x:Name="txtLogin" Height="25" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" Foreground="#1E293B"/>
            <PasswordBox x:Name="txtPassword" Height="25" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

            <Button x:Name="btnLogin" Content="Войти" Height="30" FontWeight="Bold"
                    Background="#0EA5E9" Foreground="White" Click="btnLogin_Click" IsDefault="True" Margin="0,0,0,15" Cursor="Hand"/>

            <Button x:Name="btnTest" Content="ТЕСТ: Окно сотрудников" Height="25" 
                    Background="#0EA5E9" Foreground="White" Click="btnTest_Click" Cursor="Hand" Margin="0,0,0,15"/>

            <!-- ссылка для перехода на регистрацию нового администратора -->
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink x:Name="lnkRegistraciya" Click="lnkRegistraciya_Click" Foreground="#0EA5E9">
                    Создать пользователя (Админа)
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
