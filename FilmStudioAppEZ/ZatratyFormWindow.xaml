<Window x:Class="FilmStudioAppEZ.ZatratyFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Icon="Images/icon-redactproect.png"
        Title="Управление затратами" Height="300" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Выбор проекта -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Проект киностудии:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox x:Name="cbProekt" Grid.Row="0" Grid.Column="1" Margin="0,5" Height="25" DisplayMemberPath="Название" SelectedValuePath="Код_проекта"/>

        <!-- Тип затраты -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип финансовой затраты:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox x:Name="cbTipZatrat" Grid.Row="1" Grid.Column="1" Margin="0,5" Height="25" DisplayMemberPath="Наименование" SelectedValuePath="Код_типа_затраты"/>

        <!-- Сумма затраты -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Сумма расхода (руб):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtSumma" Grid.Row="2" Grid.Column="1" Margin="0,5" Height="25"/>

        <!-- Дата затраты -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата проведения:" VerticalAlignment="Center" Margin="0,5"/>
        <DatePicker x:Name="dpData" Grid.Row="3" Grid.Column="1" Margin="0,5" Height="25"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSohranit" Content="сохранить" Background="#0EA5E9" Foreground="White" Width="110" Height="32" Margin="0,0,10,0" Click="btnSohranit_Click"/>
            <Button x:Name="btnOtmena" Content="сбросить" Background="#CBD5E1" Foreground="Black" Width="110" Height="32" Click="btnOtmena_Click"/>
        </StackPanel>
    </Grid>
</Window>
