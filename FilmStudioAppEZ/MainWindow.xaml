<Window x:Class="FilmStudioAppEZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Cursor="Hand"
        Icon="Images/icon-menu.png"
        Background="#F8F9FA"
        Title="Главное меню" Height="500" Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- шапка с приветствием -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Добро пожаловать, " FontSize="16" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBlock x:Name="txtImya" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0EA5E9"/>
            <TextBlock Text=" (" FontSize="16" VerticalAlignment="Center" Foreground="#64748B"/>
            <TextBlock x:Name="txtRol" FontSize="16" FontStyle="Italic" VerticalAlignment="Center" Foreground="#64748B"/>
            <TextBlock Text=")" FontSize="16" VerticalAlignment="Center" Foreground="#64748B"/>
        </StackPanel>

        <!-- сетка кнопок модулей -->
        <UniformGrid Grid.Row="1" Rows="3" Columns="3" Margin="0,0,0,15">
            <Button x:Name="btnSotrudniki" Content="Сотрудники" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnSotrudniki_Click"/>
            <Button x:Name="btnProekty" Content="Проекты" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnProekty_Click"/>
            <Button x:Name="btnPloshchadki" Content="Площадки" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnPloshchadki_Click"/>
            <Button x:Name="btnSemka" Content="Съёмочная группа" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnSemka_Click"/>
            <Button x:Name="btnGrafik" Content="График съёмок" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnGrafik_Click"/>
            <Button x:Name="btnZatraty" Content="Затраты" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnZatraty_Click"/>
            <Button x:Name="btnProkat" Content="Прокат" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="5" Click="btnProkat_Click"/>
        </UniformGrid>

        <!-- нижняя панель с кнопкой выхода -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnVyhod" Content="Выход" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Width="100" Height="30" Click="btnVyhod_Click"/>
        </StackPanel>
    </Grid>
</Window>
