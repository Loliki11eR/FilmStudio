<Window x:Class="FilmStudioAppEZ.GrafikFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FilmStudioAppEZ"
        mc:Ignorable="d"
        Icon="Images/icon-redactproect.png"
        Title="Управление расписанием" Height="340" Width="420" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Дата -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата съёмки:" VerticalAlignment="Center" Margin="0,5"/>
        <DatePicker x:Name="dpData" Grid.Row="0" Grid.Column="1" Margin="0,5" Height="25"/>

        <!-- Время -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Время съёмки (чч:мм):" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtVremya" Grid.Row="1" Grid.Column="1" Margin="0,5" Height="25"/>

        <!-- Проект -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Проект:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox x:Name="cbProekt" Grid.Row="2" Grid.Column="1" Margin="0,5" Height="25" DisplayMemberPath="Название" SelectedValuePath="Код_проекта"/>

        <!-- Площадка -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Съёмочная площадка:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox x:Name="cbPloshadka" Grid.Row="3" Grid.Column="1" Margin="0,5" Height="25" DisplayMemberPath="Адрес" SelectedValuePath="Код_площадки"/>

        <!-- Сцена -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Номер или имя сцены:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="txtScena" Grid.Row="4" Grid.Column="1" Margin="0,5" Height="25"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSohranit" Content="сохранить" Background="#0EA5E9" Foreground="White" Width="110" Height="32" Margin="0,0,10,0" Click="btnSohranit_Click"/>
            <Button x:Name="btnOtmena" Content="сбросить" Background="#CBD5E1" Foreground="Black" Width="110" Height="32" Click="btnOtmena_Click"/>
        </StackPanel>
    </Grid>
</Window>
